{
  "name": "mcp-studio",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual Postman & DevTools suite for Model Context Protocol (MCP) servers, tools, resources, and AI agents.",
  "author": "MCP Studio Open Source Team",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "cursor",
    "ai-tools",
    "postman-for-ai",
    "devtools",
    "developer-tools",
    "ollama",
    "llm-agent"
  ],
  "bin": "./bin/mcp-studio.js",
  "files": [
    "bin",
    "server",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"magenta.bold,cyan.bold\" \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
